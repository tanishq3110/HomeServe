{
  "name": "homeserve-server",
  "version": "1.0.0",
  "description": "HomeServe Backend REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles --testTimeout=30000"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
