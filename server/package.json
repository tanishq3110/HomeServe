    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
